{
  "name": "@tumbaland/core",
  "version": "1.9.6",
  "description": "Core shared functionality for Tumbaland backend services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "release": "standard-version && npm run build && npm publish --access public",
    "release:beta": "standard-version --prerelease beta && npm run build && npm publish --access public --tag beta"
  },
  "keywords": [
    "tumbaland",
    "backend",
    "shared",
    "core",
    "microservices"
  ],
  "author": "Tumbaland Team",
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jaeger-client": "^3.18.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.0",
    "standard-version": "^9.5.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jaeger-client": "^3.19.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "prom-client": "^15.1.3",
    "uuid": "^14.0.1",
    "winston": "^3.19.0"
  },
  "peerDependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.18.2"
  }
}
