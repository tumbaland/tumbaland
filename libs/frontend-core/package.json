{
  "name": "@tumbaland/frontend-core",
  "version": "1.21.1",
  "description": "Shared frontend logic, components and theme for Tumbaland frontends",
  "author": "Tumbaland",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "release": "commit-and-tag-version && npm run build && npm publish --access public && node ../../scripts/sync-lib-versions.mjs",
    "release:beta": "commit-and-tag-version --prerelease beta && npm run build && npm publish --access public --tag beta",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "lint": "vp lint .",
    "typecheck": "tsc --noEmit"
  },
  "commit-and-tag-version": {
    "tagPrefix": "frontend-core-v"
  },
  "dependencies": {
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "commit-and-tag-version": "^13.3.0",
    "typescript": "^6.0.3",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./federation": {
      "types": "./dist/federation.d.ts",
      "import": "./dist/federation.js",
      "default": "./dist/federation.js"
    }
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  }
}
