{
  "name": "@tumbaland/components",
  "version": "1.18.0",
  "author": "Tumbaland",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "release": "commit-and-tag-version && npm run build && npm publish --access public",
    "release:beta": "commit-and-tag-version --prerelease beta && npm run build && npm publish --access public --tag beta",
    "storybook:dev": "storybook dev -p 7000",
    "storybook:prod": "storybook build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "commit-and-tag-version": {
    "tagPrefix": "components-v"
  },
  "dependencies": {
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@tumbaland/frontend-core": "*"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "^0.28.1",
    "@rollup/rollup-linux-x64-gnu": "^4.62.2",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-onboarding": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "commit-and-tag-version": "^13.1.2",
    "storybook": "^10.4.6",
    "typescript": "^6.0.3"
  }
}
