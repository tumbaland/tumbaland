{
  "name": "@tumbaland/components",
  "version": "1.23.0",
  "author": "Tumbaland",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "release": "commit-and-tag-version && npm run build && npm publish --access public && node ../../scripts/sync-lib-versions.mjs",
    "release:beta": "commit-and-tag-version --prerelease beta && npm run build && npm publish --access public --tag beta",
    "storybook:dev": "storybook dev -p 7000",
    "storybook:prod": "storybook build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "commit-and-tag-version": {
    "tagPrefix": "components-v"
  },
  "dependencies": {
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tumbaland/frontend-core": "*"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "^0.28.2",
    "@rollup/rollup-linux-x64-gnu": "^4.63.3",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "commit-and-tag-version": "^13.2.1",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3"
  }
}
