# Environment variables for Docker Compose (do not commit this file)
# Backend
MONGODB_URI=
JWT_SECRET=
# Encrypts stored API keys so the owner can read them back. Rotating it makes existing keys unreadable (they keep working).
API_KEY_ENCRYPTION_SECRET=
GOOGLE_CLIENT_ID=
# Extra Google OAuth client IDs whose sign-in tokens auth-service accepts, comma-separated.
# Empty until there is a native iOS or Android app; each platform gets its own client ID.
GOOGLE_NATIVE_CLIENT_IDS=
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5001,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008
ALPHA_VANTAGE_API_KEY=
PAYMENT_URL=http://localhost:3005
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Internal Service Communication
INTERNAL_SERVICE_TOKEN=
GROUP_API_URL=http://localhost:5006
GROUP_INTERNAL_URL=http://localhost:5006
RELATIONSHIP_INTERNAL_URL=http://localhost:4001
# Read by mcp-service, which forwards the caller's credential to both services.
FINANCE_INTERNAL_URL=http://localhost:4003
FINANCE_API_URL=http://localhost:4003
ALBUM_INTERNAL_URL=http://localhost:4002
CHAT_API_URL=http://localhost:4004
ALBUM_API_URL=http://localhost:4002
MCP_PUBLIC_URL=http://localhost:5007
AUTH_INTERNAL_URL=http://localhost:5001
# Where services read entitlements from (payment-service, internal port)
PAYMENT_API_URL=http://localhost:5005
PAYMENT_INTERNAL_URL=http://localhost:5005

# Frontend
VITE_GOOGLE_CLIENT_ID=
VITE_ALBUM_API_URL=http://localhost:4002
VITE_AUTH_SERVICE_URL=http://localhost:5001
# Server-side names for the OAuth authorization server: the issuer it puts in
# tokens, and where an unauthenticated visitor is sent to sign in.
AUTH_SERVICE_URL=
AUTH_FRONT_URL=
VITE_AUTH_FRONT_URL=http://localhost:3004
VITE_FINANCE_API_URL=http://localhost:4003
VITE_RELATIONSHIP_FRONT_URL=http://localhost:3001
VITE_ALBUM_FRONT_URL=http://localhost:3002
VITE_FINANCE_FRONT_URL=http://localhost:3003
VITE_RELATIONSHIP_API_URL=http://localhost:4001
VITE_PUBLIC_API_URL=http://localhost:5003
VITE_PAYMENT_FRONT_URL=http://localhost:3005
VITE_PAYMENT_API_URL=http://localhost:5005
VITE_GROUP_FRONT_URL=http://localhost:3006
VITE_GROUP_API_URL=http://localhost:5006
VITE_ACCOUNT_FRONT_URL=http://localhost:3007
VITE_SHELL_FRONT_URL=http://localhost:3000
VITE_CHAT_API_URL=http://localhost:4004
VITE_CHAT_FRONT_URL=http://localhost:3008

# Web Push (chat notifications). Generate with: npx web-push generate-vapid-keys
# The public key is served to browsers; the private key never leaves the server,
# so it must never be given a VITE_ name. Leave all three blank to run chat
# without notifications.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Calls. Cloudflare dashboard > Realtime > TURN Server > Create gives both. The
# token mints relay credentials, so like the VAPID private key it never gets a
# VITE_ name. Leave both blank for STUN only, which is enough on one Wi-Fi.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Infra
CLOUDFLARE_API_TOKEN=

# Elk
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
KIBANA_ADMIN_PASSWORD=
XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTIONKEY=
