# Environment variables for Docker Compose (do not commit this file)
# Backend
MONGODB_URI=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLOUD_KEY_FILE_BASE64=
COOKIE_DOMAIN=localhost
GOOGLE_CLOUD_PROJECT_ID=tumbaland
GOOGLE_CLOUD_BUCKET_NAME=tumbabucket
CORS_ORIGIN=http://localhost:5001,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007
ALPHA_VANTAGE_API_KEY=
PAYMENT_URL=http://localhost:3005
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Internal Service Communication
INTERNAL_SERVICE_TOKEN=
GROUP_API_URL=http://localhost:5006
AUTH_API_URL=http://localhost:5001
# Where services read entitlements from (payment-service, internal port)
PAYMENT_API_URL=http://localhost:5005

# Entitlements: off | observe | enforce. Observe records usage and logs what
# would have been blocked without blocking anything — the limits start as
# guesses, and this is how they stop being guesses.
ENTITLEMENTS_MODE=observe

# Frontend
VITE_GOOGLE_CLIENT_ID=
VITE_ALBUM_API_URL=http://localhost:4002
