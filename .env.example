# Everything the app services' compose files read, and nothing else.
#
# In production these come from GitHub secrets and variables:
# .github/scripts/write-deploy-env.sh writes them to .env.app on the Pi, and its
# KEYS list is the contract. Keep this file and that list in step.
#
# Running locally without Docker, each app reads its own .env instead: copy
# apps/<tier>/<app>/.env.example next to it. Frontends there use VITE_ names.
# Infrastructure (proxy, ELK, RabbitMQ, ...) has its own .env.example under
# apps/infra/<name>/.
#
# The defaults below are for running everything on localhost.

# ─── Secrets ─────────────────────────────────────────────────────────────────
MONGODB_URI=
JWT_SECRET=
# Encrypts stored API keys so the owner can read them back. Rotating it makes
# existing keys unreadable (they keep working).
API_KEY_ENCRYPTION_SECRET=
# Shared by the services to call each other's /internal routes.
INTERNAL_SERVICE_TOKEN=

# ─── Sign-in (auth-service, auth-front) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
# Extra Google OAuth client IDs whose sign-in tokens auth-service accepts,
# comma-separated. Empty until there is a native iOS or Android app.
GOOGLE_NATIVE_CLIENT_IDS=
COOKIE_DOMAIN=localhost
# Every origin that calls the APIs, comma-separated: the frontends, and
# auth-service itself for its sign-in consent page.
CORS_ORIGIN=http://localhost:5001,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008,http://localhost:3009

# ─── Payments (payment-service) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends people back to after checkout.
PAYMENT_URL=http://localhost:3005

# ─── Finance (finance-service) ───────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=

# ─── Files (file-service, and album and chat, which mint its URLs) ───────────
FILE_SERVICE_URL=http://localhost:5002
FILE_SERVICE_PUBLIC_URL=http://localhost:5002
FILE_SERVICE_API_KEY=
FILE_SERVICE_HMAC_SECRET=
# Optional: where file-service keeps the files on the host. Defaults to ./data
# beside its compose file.
# FILE_DATA_PATH=

# ─── Web Push (chat notifications) ───────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# The public key is served to browsers; the private key never leaves
# chat-service. Leave all three blank to run chat without notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Calls (chat-service) ────────────────────────────────────────────────────
# Cloudflare dashboard > Realtime > TURN Server > Create gives both. Leave both
# blank for STUN only, which is enough on one Wi-Fi.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ─── APIs, as browsers reach them ────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:5001
PUBLIC_API_URL=http://localhost:5003
GROUP_API_URL=http://localhost:5006
ALBUM_API_URL=http://localhost:4002
FINANCE_API_URL=http://localhost:4003
RELATIONSHIP_API_URL=http://localhost:4001
CHAT_API_URL=http://localhost:4004
PAYMENT_API_URL=http://localhost:5005
# The address assistants connect to over MCP; auth-service names it in OAuth.
MCP_PUBLIC_URL=http://localhost:5007
# The administration screens' API. Only an administrator's session is answered.
ADMIN_API_URL=http://localhost:5008

# ─── APIs, as the services reach each other ──────────────────────────────────
# Inside Docker these are container addresses (http://group-service:5006);
# each falls back to its public *_API_URL when unset.
GROUP_INTERNAL_URL=http://localhost:5006
ALBUM_INTERNAL_URL=http://localhost:4002
CHAT_INTERNAL_URL=http://localhost:4004
FINANCE_INTERNAL_URL=http://localhost:4003
RELATIONSHIP_INTERNAL_URL=http://localhost:4001
PAYMENT_INTERNAL_URL=http://localhost:5005

# ─── Frontends ───────────────────────────────────────────────────────────────
SHELL_FRONT_URL=http://localhost:3000
RELATIONSHIP_FRONT_URL=http://localhost:3001
ALBUM_FRONT_URL=http://localhost:3002
FINANCE_FRONT_URL=http://localhost:3003
AUTH_FRONT_URL=http://localhost:3004
PAYMENT_FRONT_URL=http://localhost:3005
GROUP_FRONT_URL=http://localhost:3006
ACCOUNT_FRONT_URL=http://localhost:3007
CHAT_FRONT_URL=http://localhost:3008
ADMIN_FRONT_URL=http://localhost:3009
