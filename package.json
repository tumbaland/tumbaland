{
  "name": "tumbaland",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shell",
    "finance-front",
    "relationship-front",
    "finance-back",
    "relationship-back"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:shell\" \"npm run dev:finance\" \"npm run dev:relationship\" \"npm run dev:finance-back\" \"npm run dev:relationship-back\"",
    "dev:shell": "npm run dev -w shell",
    "dev:finance": "npm run dev -w finance-front",
    "dev:relationship": "npm run dev -w relationship-front",
    "dev:finance-back": "npm run dev -w finance-back",
    "dev:relationship-back": "npm run dev -w relationship-back",
    "build": "npm run build:finance && npm run build:relationship && npm run build:shell && npm run build:finance-back && npm run build:relationship-back",
    "build:shell": "npm run build -w shell",
    "build:finance": "npm run build -w finance-front",
    "build:relationship": "npm run build -w relationship-front",
    "build:finance-back": "npm run build -w finance-back",
    "build:relationship-back": "npm run build -w relationship-back",
    "preview": "npm run preview -w shell"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "React Microfrontend Application with Backend Services",
  "dependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^0.0.0-experimental-f7396427-20250501",
    "react-dom": "^0.0.0-experimental-f7396427-20250501",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "cors": "^2.8.5",
    "express": "^4.19.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2"
  }
}
