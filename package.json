{
  "name": "tumbaland",
  "version": "1.0.0",
  "private": true,
  "description": "Scalable microfrontend and microservices platform",
  "workspaces": [
    "apps/frontends/*",
    "apps/backends/core/*",
    "apps/backends/domain/*"
  ],
  "scripts": {
    "dev:shell": "npm run dev -w apps/frontends/shell",
    "dev:finance-frontend": "npm run dev -w apps/frontends/finance",
    "dev:relationship-frontend": "npm run dev -w apps/frontends/relationship",
    "dev:front": "concurrently \"npm run dev:shell\" \"npm run dev:finance-frontend\" \"npm run dev:relationship-frontend\"",
    "dev:finance-service": "npm run dev -w apps/backends/domain/finance-service",
    "dev:relationship-service": "npm run dev -w apps/backends/domain/relationship-service",
    "dev:back": "concurrently \"npm run dev:finance-service\" \"npm run dev:relationship-service\"",
    "dev:all": "concurrently \"npm run dev:front\" \"npm run dev:back\"",
    "dev": "npm run dev:front",
    "build:shell": "npm run build -w apps/frontends/shell",
    "build:finance-frontend": "npm run build -w apps/frontends/finance", 
    "build:relationship-frontend": "npm run build -w apps/frontends/relationship",
    "build:finance-service": "npm run build -w apps/backends/domain/finance-service",
    "build:relationship-service": "npm run build -w apps/backends/domain/relationship-service",
    "build:front": "concurrently \"npm run build:shell\" \"npm run build:finance-frontend\" \"npm run build:relationship-frontend\"",
    "build:back": "concurrently \"npm run build:finance-service\" \"npm run build:relationship-service\"",
    "build": "npm run build:front && npm run build:back",
    "lint": "echo \"Error: no lint specified\" && exit 1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "fs-extra": "^11.3.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/tumbaland.git"
  },
  "keywords": [
    "microfrontend",
    "microservices",
    "react",
    "typescript",
    "monorepo"
  ],
  "author": "Toomas Tahves",
  "license": "MIT"
}
