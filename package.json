{
  "name": "tumbaland",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shell",
    "finance-front",
    "relationship-front"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:shell\" \"npm run dev:finance\" \"npm run dev:relationship\"",
    "dev:shell": "npm run dev -w shell",
    "dev:finance": "npm run dev -w finance-front",
    "dev:relationship": "npm run dev -w relationship-front",
    "build": "npm run build:finance && npm run build:relationship && npm run build:shell",
    "build:shell": "npm run build -w shell",
    "build:finance": "npm run build -w finance-front",
    "build:relationship": "npm run build -w relationship-front",
    "preview": "npm run preview -w shell"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "React Microfrontend Application",
  "dependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^0.0.0-experimental-f7396427-20250501",
    "react-dom": "^0.0.0-experimental-f7396427-20250501",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
