{
  "name": "tumbaland",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shell",
    "finance-front",
    "relationship-front",
    "finance-back",
    "relationship-back"
  ],
  "scripts": {
    "dev:frontends": "concurrently \"npm run dev -w shell\" \"npm run dev -w finance-front\" \"npm run dev -w relationship-front\"",
    "dev": "npm run dev:frontends",
    "build:frontends": "npm run build -w shell && npm run build -w finance-front && npm run build -w relationship-front",
    "build": "npm run build:frontends"
  },
  "keywords": [],
  "author": "Toomas Tahves",
  "dependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "cors": "^2.8.5",
    "express": "^4.19.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/react-router-dom": "^5.3.3",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2"
  }
}
