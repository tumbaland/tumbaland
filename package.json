{
  "name": "tumbaland",
  "version": "1.0.0",
  "private": true,
  "description": "Scalable microfrontend and microservices platform",
  "workspaces": [
    "apps/frontend/*",
    "apps/backend/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:back": "concurrently \"npm run dev --workspace=file-service\" \"npm run dev --workspace=finance-service\" \"npm run dev --workspace=relationship-service\"",
    "dev:front": "concurrently \"npm run dev --workspace=collage-front\" \"npm run dev --workspace=finance-front\" \"npm run dev --workspace=relationship-front\"",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace=finance-service && npm run build --workspace=relationship-service",
    "build:frontend": "npm run build --workspace=finance-front && npm run build --workspace=relationship-front",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "concurrently \"npm run start --workspace=finance-service\" \"npm run start --workspace=relationship-service\"",
    "start:frontend": "concurrently \"npm run preview --workspace=finance-front\" \"npm run preview --workspace=relationship-front\"",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "fs-extra": "^11.3.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@google-cloud/storage": "^7.16.0",
    "@mui/icons-material": "^7.1.2",
    "@mui/material": "^7.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^2.15.4",
    "uuid": "^11.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/tumbaland.git"
  },
  "keywords": [
    "microfrontend",
    "microservices",
    "react",
    "typescript",
    "monorepo"
  ],
  "author": "Toomas Tahves",
  "license": "MIT"
}
