{
  "name": "public-service",
  "version": "1.0.0",
  "author": "Toomas Tahves",
  "license": "MIT",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --watch --require ts-node/register src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "mkdir -p dist/data && cp ./src/data/todos.json dist/data/todos.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tumbaland/backend-core": "1.50.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  }
}
