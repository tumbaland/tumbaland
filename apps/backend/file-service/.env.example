PORT=5002
NODE_ENV=development

# Shared secret used to sign/verify HMAC tokens for browser-direct upload/download URLs
FILE_SERVICE_HMAC_SECRET=change_me_to_a_long_random_secret

# Internal API key used by other backend services for server-to-server calls
FILE_SERVICE_API_KEY=change_me_to_another_long_random_secret

# Public base URL of this service (used when building signed URLs returned to clients)
FILE_SERVICE_PUBLIC_URL=http://localhost:5002

# Directory where files are stored (relative to CWD in dev, absolute in Docker)
FILE_SERVICE_DATA_DIR=./data

# Browsers upload and download here directly, so the frontend origins must be allowed
CORS_ORIGIN=http://localhost:5001,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008

# Optional: the largest upload accepted, in bytes (default 95 MB, under Cloudflare's 100 MB)
# FILE_SERVICE_MAX_UPLOAD_BYTES=
