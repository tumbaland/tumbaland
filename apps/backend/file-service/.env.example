PORT=4010
NODE_ENV=development

# Shared secret used to sign/verify HMAC tokens for browser-direct upload/download URLs
FILE_SERVICE_HMAC_SECRET=change_me_to_a_long_random_secret

# Internal API key used by other backend services for server-to-server calls
FILE_SERVICE_API_KEY=change_me_to_another_long_random_secret

# Public base URL of this service (used when building signed URLs returned to clients)
FILE_SERVICE_PUBLIC_URL=http://localhost:4010

# Directory where files are stored (relative to CWD in dev, absolute in Docker)
FILE_SERVICE_DATA_DIR=./data
