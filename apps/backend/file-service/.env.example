# Environment Configuration

# Server Configuration
PORT=5002
NODE_ENV=development

# Google Cloud Storage Configuration
GOOGLE_CLOUD_PROJECT_ID=tumbaland
GOOGLE_CLOUD_BUCKET_NAME=tumbabucket

# Option 1: Use service account key file (recommended for development)
GOOGLE_CLOUD_KEY_FILE=./credentials/tumbabucket.json

# Option 2: Use base64 encoded service account credentials (recommended for production)
# GOOGLE_CLOUD_CREDENTIALS={"type":"service_account","project_id":"tumbaland",...}

# File Cache Configuration
FILE_CACHE_DIR=./cache
CACHE_MAX_AGE=864000000
CACHE_MAX_SIZE=1073741824
CACHE_CLEANUP_INTERVAL=259200000

# CORS Configuration  
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
