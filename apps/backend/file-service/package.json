{
  "name": "file-service",
  "version": "1.0.0",
  "description": "File upload service with Google Cloud Storage integration",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
