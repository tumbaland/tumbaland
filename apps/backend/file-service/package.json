{
  "name": "file-service",
  "version": "1.0.0",
  "author": "Toomas Tahves",
  "license": "MIT",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "npm run docs:build && nodemon --exec ts-node src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run docs:build",
    "docs:build": "redocly bundle openapi/openapi.yml -o docs/openapi.yml",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tumbaland/backend-core": "1.38.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "^2.38.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
