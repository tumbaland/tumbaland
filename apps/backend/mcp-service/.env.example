# mcp-service, run locally with `npm run dev`. Copy to .env and fill in the blanks.
# MONGODB_URI, JWT_SECRET, INTERNAL_SERVICE_TOKEN and FILE_SERVICE_API_KEY must be
# the same in every service that has them.
MCP_SERVICE_PORT=5007
NODE_ENV=development

MONGODB_URI=
JWT_SECRET=
# In Docker, compose fills this from AUTH_SERVICE_URL in the root list.
AUTH_SERVICE_PUBLIC_URL=http://localhost:5001
ALBUM_API_URL=http://localhost:4002
FINANCE_API_URL=http://localhost:4003
RELATIONSHIP_API_URL=http://localhost:4001
MCP_PUBLIC_URL=http://localhost:5007
ALBUM_INTERNAL_URL=http://localhost:4002
FINANCE_INTERNAL_URL=http://localhost:4003
RELATIONSHIP_INTERNAL_URL=http://localhost:4001
