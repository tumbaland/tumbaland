# chat-service, run locally with `npm run dev`. Copy to .env and fill in the blanks.
# MONGODB_URI, JWT_SECRET, INTERNAL_SERVICE_TOKEN and FILE_SERVICE_API_KEY must be
# the same in every service that has them.
PORT=4004
NODE_ENV=development

MONGODB_URI=
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
CORS_ORIGIN=http://localhost:5001,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008
FILE_SERVICE_URL=http://localhost:5002
FILE_SERVICE_API_KEY=
# Web Push. Leave all three blank to run without notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Calls. Leave both blank for STUN only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
ALBUM_API_URL=http://localhost:4002
GROUP_INTERNAL_URL=http://localhost:5006
ALBUM_INTERNAL_URL=http://localhost:4002
PAYMENT_INTERNAL_URL=http://localhost:5005
