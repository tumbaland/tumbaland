# admin-service, run locally with `npm run dev`. Copy to .env and fill in the blanks.
# MONGODB_URI, JWT_SECRET and INTERNAL_SERVICE_TOKEN must be the same in every
# service that has them.
PORT=5008
NODE_ENV=development

MONGODB_URI=
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=
CORS_ORIGIN=http://localhost:3000,http://localhost:3009
# Plans and limits are asked of payment-service (backend-core getEntitlements).
PAYMENT_INTERNAL_URL=http://localhost:5005
# Membership is asked of group-service (backend-core currentGroupsOf).
GROUP_INTERNAL_URL=http://localhost:5006
