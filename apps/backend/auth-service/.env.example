# auth-service, run locally with `npm run dev`. Copy to .env and fill in the blanks.
# MONGODB_URI, JWT_SECRET, INTERNAL_SERVICE_TOKEN and FILE_SERVICE_API_KEY must be
# the same in every service that has them.
PORT=5001
NODE_ENV=development

MONGODB_URI=
JWT_SECRET=
API_KEY_ENCRYPTION_SECRET=
INTERNAL_SERVICE_TOKEN=
GOOGLE_CLIENT_ID=
# Comma-separated; empty until there is a native app.
GOOGLE_NATIVE_CLIENT_IDS=
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5001,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008
# In Docker, compose fills this from AUTH_SERVICE_URL in the root list.
AUTH_SERVICE_PUBLIC_URL=http://localhost:5001
GROUP_API_URL=http://localhost:5006
MCP_PUBLIC_URL=http://localhost:5007
AUTH_FRONT_URL=http://localhost:3004
