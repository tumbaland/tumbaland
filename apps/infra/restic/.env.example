# Tumbaland Backup Configuration
# Only sensitive variables that should be set via GitHub Actions secrets

# 🔒 GITHUB SECRET REQUIRED: Restic repository password
RESTIC_PASSWORD=

# 🔒 GITHUB SECRET REQUIRED: AWS S3 access key (optional for offsite backup)
BACKUP_AWS_ACCESS_KEY_ID=

# 🔒 GITHUB SECRET REQUIRED: AWS S3 secret key (optional for offsite backup)
BACKUP_AWS_SECRET_ACCESS_KEY=

# 🔒 GITHUB SECRET REQUIRED: SMTP password for email notifications
SMTP_PASSWORD=

# 🔒 GITHUB SECRET REQUIRED: MinIO backup instance password (optional)
MINIO_BACKUP_ROOT_PASSWORD=