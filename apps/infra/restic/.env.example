# Tumbaland Backup Configuration
# Copy this file to .env and configure your backup settings

# Restic Repository Configuration
RESTIC_REPOSITORY=/media/tom/ml/projects/tumbaland/apps/infra/backup/data/restic-repo
RESTIC_PASSWORD=your_secure_restic_password_here

# Optional: S3/MinIO Backup Storage (for offsite backups)
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-1

# Email Notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=admin@tumbaland.com

# MinIO Backup Storage (optional separate instance)
MINIO_BACKUP_ROOT_USER=backup_admin
MINIO_BACKUP_ROOT_PASSWORD=backup_password_123

# Service Credentials (inherited from main .env)
# These should match your main infrastructure credentials
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123
MINIO_ROOT_USER=tumbaland_admin
MINIO_ROOT_PASSWORD=secure_password_123
REDIS_PASSWORD=redis_password_123
VAULT_DEV_ROOT_TOKEN_ID=your_vault_token