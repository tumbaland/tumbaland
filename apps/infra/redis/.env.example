# Redis Configuration for Tumbaland
# Copy this file to .env and update with your values

# Redis Authentication
REDIS_PASSWORD=secure_redis_password_123

# Redis Memory Configuration
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Redis Logging
REDIS_LOGLEVEL=notice

# Disabled Commands (Security)
REDIS_DISABLE_COMMANDS=FLUSHDB,FLUSHALL,SHUTDOWN,CONFIG

# Redis Commander (Web UI) Credentials
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=commander_secure_123

# Connection URLs (for your services)
REDIS_URL=redis://:secure_redis_password_123@localhost:6379
REDIS_URL_DOCKER=redis://:secure_redis_password_123@redis:6379

# Redis Cache Configuration
REDIS_CACHE_TTL=3600
REDIS_SESSION_TTL=86400
REDIS_RATE_LIMIT_TTL=60