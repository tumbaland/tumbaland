# Vault Configuration
VAULT_DEV_ROOT_TOKEN_ID=vault-root-token-12345

# Vault Server Settings
VAULT_ADDR=http://localhost:8200
VAULT_API_ADDR=http://localhost:8200

# Consul Integration (for service discovery)
CONSUL_HTTP_ADDR=http://consul:8500

# Database Secrets (will be stored in Vault)
VAULT_DB_USERNAME=tumbaland_user
VAULT_DB_PASSWORD=secure_db_password_123

# Redis Secrets
VAULT_REDIS_PASSWORD=secure_redis_password_123

# MinIO Secrets
VAULT_MINIO_ACCESS_KEY=tumbaland_access_key
VAULT_MINIO_SECRET_KEY=tumbaland_secret_key

# RabbitMQ Secrets
VAULT_RABBITMQ_USERNAME=admin
VAULT_RABBITMQ_PASSWORD=secure_rabbitmq_password_123

# JWT Secrets
VAULT_JWT_SECRET=your_jwt_secret_key_here

# Stripe Secrets
VAULT_STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
VAULT_STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Google Cloud Secrets
VAULT_GOOGLE_CLIENT_ID=your_google_client_id
VAULT_GOOGLE_CLOUD_KEY_FILE_BASE64=base64_encoded_key_file

# Cloudflare Secrets
VAULT_CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Internal Service Token
VAULT_INTERNAL_SERVICE_TOKEN=your_internal_service_token

# Alpha Vantage API Key
VAULT_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# File Access Secret
VAULT_FILE_ACCESS_SECRET=your_file_access_secret