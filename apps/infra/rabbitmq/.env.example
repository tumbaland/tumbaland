# RabbitMQ Configuration for Tumbaland
# Copy this file to .env and update with your values

# RabbitMQ Server Configuration
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=secure_rabbitmq_password_123
RABBITMQ_VHOST=tumbaland

# Connection URLs
RABBITMQ_URL=amqp://admin:secure_rabbitmq_password_123@localhost:5672/tumbaland
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# Queue Configuration
RABBITMQ_PHOTO_UPLOAD_QUEUE=photo.upload
RABBITMQ_IMAGE_PROCESSING_QUEUE=image.processing
RABBITMQ_NOTIFICATION_QUEUE=notification.send
RABBITMQ_AUDIT_LOG_QUEUE=audit.log
RABBITMQ_EMAIL_QUEUE=email.send

# Exchange Configuration
RABBITMQ_MAIN_EXCHANGE=tumbaland.events
RABBITMQ_DEAD_LETTER_EXCHANGE=tumbaland.dlx

# Message TTL and Retry Configuration
RABBITMQ_MESSAGE_TTL=86400000  # 24 hours in milliseconds
RABBITMQ_MAX_RETRIES=3

# Monitoring
RABBITMQ_ENABLE_METRICS=true