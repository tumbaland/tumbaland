# Alertmanager Configuration
ALERTMANAGER_SMTP_FROM=alerts@tumbaland.eu
ALERTMANAGER_SMTP_USERNAME=alerts@tumbaland.eu
ALERTMANAGER_SMTP_PASSWORD=your_smtp_password_here

# Slack Integration
ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Email Recipients
ALERTMANAGER_EMAIL_TO=admin@tumbaland.eu
ALERTMANAGER_CRITICAL_EMAIL_TO=admin@tumbaland.eu,devops@tumbaland.eu
ALERTMANAGER_DB_EMAIL_TO=dba@tumbaland.eu,admin@tumbaland.eu

# Alertmanager Settings
ALERTMANAGER_PORT=9093
ALERTMANAGER_WEB_LISTEN_ADDRESS=0.0.0.0:9093

# Prometheus Integration
PROMETHEUS_ALERTMANAGER_URL=http://alertmanager:9093