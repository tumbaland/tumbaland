# Jaeger Configuration
JAEGER_COLLECTOR_PORT=14268
JAEGER_QUERY_PORT=16686
JAEGER_AGENT_PORT=5775

# Elasticsearch Configuration (for trace storage)
ES_SERVER_URLS=http://elasticsearch:9200
SPAN_STORAGE_TYPE=elasticsearch

# Sampling Configuration
JAEGER_SAMPLING_RATE=0.1
JAEGER_SAMPLING_TYPE=probabilistic

# Service Dependencies
JAEGER_ES_INDEX_PREFIX=jaeger
JAEGER_ES_TAGS_AS_FIELDS=true

# UI Configuration
JAEGER_QUERY_BASE_PATH=/
JAEGER_UI_CONFIG=/etc/jaeger/ui-config.json

# Collector Configuration
COLLECTOR_OTLP_ENABLED=true
COLLECTOR_ZIPKIN_ENABLED=true

# Agent Configuration
JAEGER_AGENT_REPORTER_GRPC_HOST_PORT=jaeger-collector:14250
JAEGER_AGENT_REPORTER_TCHANNEL_HOST_PORT=jaeger-collector:14267