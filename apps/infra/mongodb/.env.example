# MongoDB Configuration for Tumbaland
# Copy this file to .env and update with your values

# MongoDB Root Credentials (change these!)
MONGO_ROOT_USERNAME=mongo_admin
MONGO_ROOT_PASSWORD=secure_mongo_password_123

# Database Configuration
MONGO_DATABASE=tumbaland

# Mongo Express (Web UI) Credentials
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=express_secure_123

# Timezone
TZ=UTC

# Connection URLs (for your services)
MONGO_URL=mongodb://mongo_admin:secure_mongo_password_123@localhost:27017/tumbaland?authSource=admin
MONGO_URL_DOCKER=mongodb://mongo_admin:secure_mongo_password_123@mongodb:27017/tumbaland?authSource=admin