# ELK Stack Configuration for Tumbaland
# Copy this file to .env and update with your values

# Elasticsearch Configuration
ELK_ELASTIC_PASSWORD=elastic_secure_password_123
ELK_ES_MEMORY=1g

# Logstash Configuration
ELK_LS_MEMORY=512m

# Kibana Configuration
ELK_KIBANA_MEMORY=512m

# Service URLs
ELASTICSEARCH_URL=http://localhost:9200
LOGSTASH_URL=http://localhost:9600
KIBANA_URL=http://localhost:5601

# Log Shipping Configuration
LOGSTASH_BEATS_PORT=5044
LOGSTASH_TCP_PORT=5000

# Index Patterns
ELK_INDEX_PATTERN=tumbaland-*
ELK_FILEBEAT_INDEX=filebeat-*

# Retention Settings (days)
ELK_RETENTION_DAYS=30

# Monitoring
ELK_MONITORING_ENABLED=true