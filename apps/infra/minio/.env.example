# MinIO Configuration for Tumbaland
# Copy this file to .env and update with your values

# MinIO Root Credentials (change these!)
MINIO_ROOT_USER=tumbaland_admin
MINIO_ROOT_PASSWORD=your_secure_password_here_min_8_chars

# Server URLs
MINIO_SERVER_URL=http://localhost:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# Optional: Domain configuration for production
# MINIO_DOMAIN=minio.yourdomain.com

# File Service Credentials (separate from root for security)
MINIO_FILE_SERVICE_USER=file-service-user
MINIO_FILE_SERVICE_PASSWORD=file-service-secure-password

# Bucket names
MINIO_PHOTOS_BUCKET=photos
MINIO_THUMBNAILS_BUCKET=thumbnails
MINIO_TEMP_BUCKET=temp