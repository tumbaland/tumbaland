# Copy to .env.stripe and fill in with your TEST values (never commit real keys)
# Stripe test secret API key (sk_test_...)
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Where to forward webhooks (host.docker.internal lets container reach host services)
FORWARD_TO=host.docker.internal:5005

# Optional: filter specific events (comma separated). Leave empty to get all.
# STRIPE_FORWARD_EVENTS=checkout.session.completed,invoice.payment_failed
