# HAProxy Configuration
HAPROXY_PORT_HTTP=80
HAPROXY_PORT_HTTPS=443
HAPROXY_STATS_PORT=8404

# Performance Settings
HAPROXY_MAX_CONNECTIONS=4096
HAPROXY_NBPROC=1
HAPROXY_NBTHREAD=4

# Timeouts
HAPROXY_TIMEOUT_CONNECT=5s
HAPROXY_TIMEOUT_CLIENT=30s
HAPROXY_TIMEOUT_SERVER=30s
HAPROXY_TIMEOUT_HTTP_REQUEST=10s
HAPROXY_TIMEOUT_HTTP_KEEP_ALIVE=10s

# Rate Limiting
HAPROXY_RATE_LIMIT_CONNECTIONS=100
HAPROXY_RATE_LIMIT_PER_IP=10

# Request Size Limits
HAPROXY_MAX_REQUEST_SIZE=52428800  # 50MB

# Health Check Settings
HAPROXY_HEALTH_CHECK_INTERVAL=10s
HAPROXY_HEALTH_CHECK_FALL=3
HAPROXY_HEALTH_CHECK_RISE=2

# SSL Configuration (for production)
# HAPROXY_SSL_CERT=/usr/local/etc/haproxy/ssl/tumbaland.pem
# HAPROXY_SSL_MIN_VER=TLSv1.2
# HAPROXY_SSL_MAX_VER=TLSv1.3

# Logging
HAPROXY_LOG_LEVEL=info
HAPROXY_LOG_FORMAT=raw

# Service Ports (for reference)
ALBUM_FRONT_PORT=80
ALBUM_SERVICE_PORT=4002
AUTH_FRONT_PORT=80
AUTH_SERVICE_PORT=5001
FILE_SERVICE_PORT=5002
FINANCE_FRONT_PORT=80
FINANCE_SERVICE_PORT=4003
GROUP_FRONT_PORT=80
GROUP_SERVICE_PORT=5006
PAYMENT_FRONT_PORT=80
PAYMENT_SERVICE_PORT=5005
RELATIONSHIP_FRONT_PORT=80
RELATIONSHIP_SERVICE_PORT=4001
PUBLIC_SERVICE_PORT=4000
SEGMENTATION_SERVICE_PORT=8001
OBJECT_DETECTION_SERVICE_PORT=8002