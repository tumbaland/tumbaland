{
  "datacenter": "tumbaland-dc",
  "log_level": "WARN",
  "node_name": "consul-server",
  "server": true,
  "bootstrap_expect": 1,
  "ui_config": {
    "enabled": true
  },
  "ports": {
    "http": 8500,
    "https": -1,
    "grpc": -1
  },
  "addresses": {
    "http": "0.0.0.0"
  },
  "connect": {
    "enabled": true
  },
  "telemetry": {
    "prometheus_retention_time": "60s",
    "disable_hostname": true,
    "statsite_address": "",
    "statsd_address": "",
    "dogstatsd_addr": ""
  },
  "acl": {
    "enabled": true,
    "default_policy": "deny",
    "down_policy": "extend-cache"
  },
  "performance": {
    "raft_multiplier": 1,
    "leave_drain_time": "5s",
    "rpc_hold_timeout": "7s"
  },
  "limits": {
    "http_max_conns_per_client": 100,
    "rpc_max_conns_per_client": 20,
    "rpc_rate": 1000.0,
    "rpc_max_burst": 1000
  }
}