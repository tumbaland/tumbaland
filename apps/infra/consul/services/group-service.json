{
  "service": {
    "name": "group-service",
    "tags": ["backend", "api", "group"],
    "port": 5006,
    "address": "group-service",
    "check": {
      "http": "http://group-service:5006/health",
      "interval": "30s",
      "timeout": "5s",
      "deregister_critical_service_after": "5m"
    },
    "meta": {
      "version": "1.0",
      "environment": "production"
    }
  }
}