{
  "service": {
    "name": "payment-front",
    "tags": ["frontend", "web", "payment"],
    "port": 80,
    "address": "payment-front",
    "check": {
      "http": "http://payment-front/health",
      "interval": "60s",
      "timeout": "5s",
      "deregister_critical_service_after": "10m"
    },
    "meta": {
      "version": "1.0",
      "environment": "production",
      "type": "frontend"
    }
  }
}