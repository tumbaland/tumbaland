{
  "service": {
    "name": "file-service",
    "tags": ["backend", "api", "file", "storage"],
    "port": 5002,
    "address": "file-service",
    "check": {
      "http": "http://file-service:5002/health",
      "interval": "30s",
      "timeout": "5s",
      "deregister_critical_service_after": "5m"
    },
    "meta": {
      "version": "1.0",
      "environment": "production"
    }
  }
}