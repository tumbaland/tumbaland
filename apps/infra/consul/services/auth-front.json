{
  "service": {
    "name": "auth-front",
    "tags": ["frontend", "web", "auth"],
    "port": 80,
    "address": "auth-front",
    "check": {
      "tcp": "auth-front:80",
      "interval": "30s",
      "timeout": "5s",
      "deregister_critical_service_after": "5m"
    },
    "meta": {
      "version": "1.0",
      "environment": "production",
      "type": "frontend"
    }
  }
}