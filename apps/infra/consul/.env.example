# Consul Configuration for Tumbaland
# Copy this file to .env and update with your values

# Consul Server Configuration
CONSUL_DATACENTER=tumbaland-dc
CONSUL_NODE_NAME=consul-server-01
CONSUL_HTTP_PORT=8500
CONSUL_DNS_PORT=8600

# Service Registration
CONSUL_SERVICE_PREFIX=tumbaland

# Health Check Configuration
CONSUL_HEALTH_CHECK_INTERVAL=30s
CONSUL_HEALTH_CHECK_TIMEOUT=10s

# Key-Value Store Configuration
CONSUL_KV_PREFIX=config/tumbaland

# Service Mesh (Consul Connect)
CONSUL_CONNECT_ENABLED=true

# Monitoring
CONSUL_METRICS_ENABLED=true
CONSUL_PROMETHEUS_RETENTION=24h

# ACL (Access Control Lists) - Set to true for production
CONSUL_ACL_ENABLED=false
CONSUL_ACL_DEFAULT_POLICY=allow

# DNS Configuration
CONSUL_DNS_RECURSORS=8.8.8.8,8.8.4.4
CONSUL_DNS_ONLY_PASSING=true

# UI Configuration
CONSUL_UI_ENABLED=true