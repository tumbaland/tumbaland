{
  "datacenter": "tumbaland-dc",
  "log_level": "INFO",
  "node_name": "consul-client",
  "server": false,
  "ports": {
    "http": -1,
    "https": -1,
    "grpc": -1
  },
  "connect": {
    "enabled": true
  },
  "telemetry": {
    "prometheus_retention_time": "30s",
    "disable_hostname": true
  },
  "acl": {
    "enabled": true,
    "default_policy": "deny",
    "down_policy": "extend-cache"
  }
}