{
  "datacenter": "tumbaland-dc",
  "log_level": "WARN",
  "node_name": "consul-client",
  "server": false,
  "ports": {
    "http": -1,
    "https": -1,
    "grpc": -1
  },
  "connect": {
    "enabled": true
  },
  "telemetry": {
    "prometheus_retention_time": "60s",
    "disable_hostname": true,
    "statsite_address": "",
    "statsd_address": "",
    "dogstatsd_addr": ""
  },
  "acl": {
    "enabled": true,
    "default_policy": "deny",
    "down_policy": "extend-cache"
  },
  "performance": {
    "leave_drain_time": "5s",
    "rpc_hold_timeout": "7s"
  },
  "limits": {
    "http_max_conns_per_client": 50,
    "rpc_max_conns_per_client": 10,
    "rpc_rate": 500.0,
    "rpc_max_burst": 500
  }
}