# Prometheus and Grafana Configuration for Tumbaland
# Copy this file to .env and update with your values

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=secure_grafana_password_123

# Prometheus Configuration
PROMETHEUS_RETENTION_TIME=200h
PROMETHEUS_SCRAPE_INTERVAL=15s

# AlertManager Configuration (optional)
ALERTMANAGER_SMTP_HOST=smtp.gmail.com
ALERTMANAGER_SMTP_PORT=587
ALERTMANAGER_SMTP_USER=alerts@tumbaland.com
ALERTMANAGER_SMTP_PASSWORD=your_smtp_password

# Slack Integration (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#tumbaland-alerts

# Monitoring
PROMETHEUS_ENABLE_LIFECYCLE=true