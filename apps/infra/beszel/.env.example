# Beszel agent credentials. Both come from the hub's "Add System" dialog on the
# first deploy — see README.md. In CI these are GitHub secrets of the same name,
# written into .env.infra by .github/workflows/deploy-infrastructure.yml.

# Public key the hub uses to authenticate itself to the agent.
# Single line, e.g. ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...
BESZEL_KEY=<change-me>

# Registration token binding this agent to its system record in the hub.
BESZEL_TOKEN=<change-me>
